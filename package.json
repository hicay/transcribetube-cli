{
  "name": "@transcribetube/cli",
  "version": "0.1.0",
  "description": "Transcribe YouTube videos, podcasts, and audio files to text, SRT, VTT, or markdown — from your terminal or directly from AI assistants via MCP.",
  "keywords": [
    "youtube",
    "youtube-transcript",
    "transcript",
    "subtitles",
    "captions",
    "srt",
    "vtt",
    "speech-to-text",
    "transcription",
    "mcp",
    "mcp-server",
    "ai",
    "claude",
    "whisper",
    "deepgram",
    "cli"
  ],
  "homepage": "https://transcribetube.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hicay/transcribetube-cli"
  },
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tube": "./bin/run.js",
    "transcribetube-mcp": "./bin/mcp.js"
  },
  "files": [
    "bin",
    "build",
    "llms.txt",
    "README.md",
    "AI_INTEGRATION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "mcp": "ts-node src/mcp/server.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=18.17"
  }
}
